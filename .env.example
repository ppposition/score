# Canvas Base URL
CANVAS_BASE_URL=https://oc.sjtu.edu.cn

# Canvas Access Token（在 Canvas 账号 → 设置 中生成）
CANVAS_TOKEN=your_token_here

# LLM Provider（openai / deepseek / moonshot 等）
LLM_BASE_URL=https://open.bigmodel.cn/api/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=glm-5.3-flash

# 扫描 PDF：必须配置支持 Responses API input_image 的视觉模型
# 本地 PDF 对话还要求该模型支持工具调用
LLM_VISION_MODEL=
# 留空时复用 LLM_BASE_URL / LLM_API_KEY；可指定独立的视觉服务
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# 评分相关
DEFAULT_MAX_SCORE=100
# true 跳过 Canvas 状态为 graded 的提交；false 允许重新评分（默认）
SKIP_GRADED_SUBMISSIONS=false
# 满分时仅提交分数，有扣分才提交评语；false 表示所有评分都提交评语
SKIP_FULL_SCORE_COMMENT=true
